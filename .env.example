# SOC-ify environment configuration (EXAMPLE - copy to .env.local and fill in)
# Never commit real credentials to git. Set these in your environment or a .env.local.

# Elasticsearch endpoint + credentials (basic auth)
SOC_ES_HOST="http://localhost:9200"
SOC_ES_USER="CHANGE_ME"          # your ES username
SOC_ES_PASS="CHANGE_ME"          # your ES password

# Index names (usually leave defaults)
SOC_INDEX="nginx-access-*"
SOC_FINDINGS="siem-findings"
SOC_FIRE_INDEX="fire-ufw-*"          # R-013 firewall source (UFW logs)
SOC_SSH_INDEX="auth-*"               # R-014/R-015 SSH source

# Detection thresholds
SOC_FREQ_THRESHOLD=30        # R-011: requests per IP per window
SOC_PATH_DISTINCT=15         # R-011: distinct paths per IP per window
SOC_CHAIN_WINDOW=15          # R-012: minutes for attack-chain correlation
SOC_SSH_FAIL=5               # R-014: failed SSH logins per IP to alert
SOC_ALLOWED_IPS=""           # R-015: comma-separated trusted admin/VPN IPs (downgrade severity)

# Alerting (scripts/alerts.py — DRAFT, optional channels). Leave empty to disable.
SOC_ALERT_STATE=""           # watermark file tracking last-sent alert
SOC_TEAMS_WEBHOOK=""         # Microsoft Teams webhook URL
SOC_TG_TOKEN=""              # Telegram bot token
SOC_TG_CHAT_ID=""            # Telegram chat ID to notify
# SOC_SMTP_HOST="" SOC_SMTP_PORT="" SOC_SMTP_USER="" SOC_SMTP_PASS=""
# SOC_SMTP_FROM="" SOC_SMTP_TO=""   # uncomment for email channel
