<Sysmon schemaversion="4.50">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <CheckRevocation/>
  <EventFiltering>
    <RuleGroup name="soc-fc" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">Startup</TargetFilename>
        <TargetFilename condition="endswith">web.config</TargetFilename>
        <TargetFilename condition="endswith">.env</TargetFilename>
      </FileCreate>
    </RuleGroup>
    <RuleGroup name="soc-fd" groupRelation="or">
      <FileDelete onmatch="include">
        <TargetFilename condition="contains">Startup</TargetFilename>
        <TargetFilename condition="endswith">.env</TargetFilename>
      </FileDelete>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
